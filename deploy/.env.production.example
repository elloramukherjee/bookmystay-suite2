# Production environment for BookMyStay. Copy to .env.production, fill in, keep it OFF git.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=production
PORT=4000
SERVE_CLIENT=true

# Public origin guests and staff use (must be https in production)
CLIENT_URL=https://stay.example.in
TRUST_PROXY=1

# MongoDB: Atlas connection string, or leave as set by deploy/docker-compose.yml
MONGODB_URI=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
IP_HASH_SALT=

# Payments: "razorpay" (online) needs the three values below. "pay_at_hotel" needs nothing: website bookings are
# confirmed at once and the guest pays at the property (collect before check-out). The mock provider is refused.
PAYMENT_PROVIDER=pay_at_hotel
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# AI receptionist (optional; without it chats go to staff)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=LOW

# WhatsApp Cloud API (optional; simulator mode until set). See docs/WHATSAPP-SETUP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATES=

# No SMS/email gateway in this version: undeliverable messages become staff call tasks
SMS_PROVIDER=console
EMAIL_PROVIDER=console

LOG_LEVEL=info
