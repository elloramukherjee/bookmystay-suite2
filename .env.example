# ─────────────────────────────────────────────────────────────────────────────
# BookMyStay Suite — environment configuration
# Copy to .env (or run `npm run setup:env` to generate one with random secrets).
# NEVER commit .env. NEVER expose any of these values to the React client.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/bookmystay

# 32+ random characters each, and different from each other.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Google Gemini (server-side only). Leave the key empty to run the receptionist in "AI offline" mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: model for the one retry when the primary is overloaded; thinking level (LOW recommended for chat speed;
# MINIMAL/MEDIUM/HIGH support is model-dependent, empty = model default); reply timeout before the chat goes to staff.
GEMINI_FALLBACK_MODEL=
GEMINI_THINKING_LEVEL=LOW
GEMINI_TIMEOUT_MS=12000

# WhatsApp Cloud API (Meta). If any of these are empty, the server runs in simulator mode: every flow works and
# messages are recorded as "simulated" (nothing is sent). Setup steps: docs/WHATSAPP-SETUP.md
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
# Approved templates for confirmations etc. outside the 24-hour window (see docs/WHATSAPP-SETUP.md §4)
WHATSAPP_TEMPLATES=

# Payments: "razorpay" (online UPI/card), "pay_at_hotel" (no gateway: website bookings are confirmed at once and the
# guest pays at the property), or "mock" (development only, REFUSED in production).
PAYMENT_PROVIDER=mock
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=
# Razorpay: Dashboard → Webhooks secret (verifies X-Razorpay-Signature)
PAYMENT_WEBHOOK_SECRET=

# Messaging fallbacks. This version has no SMS/email gateway: "console" only logs, and undeliverable important
# messages become staff call tasks (Hotel Settings → Guest messaging).
SMS_PROVIDER=console
SMS_API_KEY=
EMAIL_PROVIDER=console
SMTP_URL=

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173
# Number of proxy hops in front of the API (e.g. 1 behind a load balancer)
TRUST_PROXY=0
# Production: serve the built web app from the API (one origin). See docs/DEPLOYMENT.md
SERVE_CLIENT=false
LOG_LEVEL=info
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_MAX=300
# Salt for one-way IP hashing in audit logs (must be unique in production)
IP_HASH_SALT=

# Development seed: password for newly-created sample staff accounts (optional — a random one is printed if empty)
SEED_DEFAULT_PASSWORD=
